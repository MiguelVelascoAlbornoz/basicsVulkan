#version 450
#include "../glsl/fftGeral.glsl"
#include "../glsl/random.glsl"
layout(local_size_x = 1) in;
layout(binding = 0, rg32f) uniform image2D fftDataIn;




void setWave(vec2 k, float amp, float phase) {
    ivec2 idx = kToIndex(k);
    ivec2 idxOp = kToIndex(-k); // índice de la frecuencia opuesta

    vec2 valor = amp * vec2(cos(phase), sin(phase));
    imageStore(fftDataIn,idx,vec4(valor,0.0f,0.0f));
    //imageStore(fftDataIn,idxOp,vec4(valor.x,-valor.y,0.0f,0.0f));

}

float phillips(vec2 k, vec2 windDir, float windSpeed, float A) {
    float kLen = length(k);
    if (kLen < 0.0001) return 0.0;

    float L = (windSpeed * windSpeed) / G; // G = 9.81

    vec2 kHat = k / kLen;
    float kDotW = dot(kHat, normalize(windDir));

    float phillips = A * exp(-1.0 / pow(kLen * L, 2.0)) / pow(kLen, 4.0);
    phillips *= kDotW * kDotW; // factor direccional básico

    return phillips;
}
vec2 boxMuller(ivec2 seed) {
    float u1 = randomFloat(seed.x);
    float u2 = randomFloat(seed.y);
    float r = sqrt(-2.0 * log(max(u1, 1e-6)));
    float theta = 2.0 * PI * u2;
    return vec2(r * cos(theta), r * sin(theta));
}
void main(){

    for (int i = 0; i < 512; ++i){
        for (int j = 0; j <512; ++j){
            vec2 k = calculateK(i,j);
            vec2 gauss = boxMuller(ivec2(i,j));
            float ph =phillips(k,windDir,windSpeed,As);
            vec2 h0 = sqrt(ph * 0.5) * gauss;
            imageStore(fftDataIn, ivec2(i,j), vec4(h0, 0.0, 0.0));
        }
    }


}
