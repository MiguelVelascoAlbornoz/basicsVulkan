#version 450
#include "../glsl/fftGeral.glsl"

layout(local_size_x = 1) in;
layout(binding = 0, rg32f) uniform image2D fftDataIn;



void setWave(vec2 k, float amp, float phase) {
    ivec2 idx = kToIndex(k);
    ivec2 idxOp = kToIndex(-k); // índice de la frecuencia opuesta

    vec2 valor = amp * vec2(cos(phase), sin(phase));
    imageStore(fftDataIn,idx,vec4(valor,0.0f,0.0f));
    imageStore(fftDataIn,idxOp,vec4(valor.x,-valor.y,0.0f,0.0f));

}


void main(){
    // --- Olas grandes (k bajo, longitud de onda larga), amplitud alta ---
    setWave(vec2( 6.283,  0.0),    0.0035, 0.0);
    setWave(vec2( 0.0,    6.283),  0.0030, 1.1);
    setWave(vec2(-6.283,  6.283),  0.0028, 2.3);
    setWave(vec2( 6.283, -6.283),  0.0025, 0.6);
    setWave(vec2(-6.283, -6.283),  0.0022, 3.4);

    // --- Olas medianas, direcciones variadas, amplitud media ---
    setWave(vec2( 12.566,  6.283), 0.0015, 0.9);
    setWave(vec2(-12.566,  6.283), 0.0014, 2.7);
    setWave(vec2( 6.283,  12.566), 0.0013, 4.1);
    setWave(vec2(-6.283, -12.566), 0.0012, 1.5);
    setWave(vec2( 18.850,  0.0),   0.0011, 5.0);
    setWave(vec2( 0.0,   -18.850), 0.0010, 0.3);
    setWave(vec2( 12.566, -12.566),0.0010, 3.9);
    setWave(vec2(-12.566, -6.283), 0.0009, 2.0);


}