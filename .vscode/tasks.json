{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "options" : {
                "shell": {
                    "executable": "cmd",
                    "args": ["/d", "/c"]
                }
            },
            "label": "Build release",
            "command": "g++",
            //comando entero: 
//g++ -O3 -Wall -Wextra -Werror -Wno-unused-result -DPROJECT_NAME=BasicsVulkan -DPROJECT_VERSION=ghjk -Isrc\external\includes -Lsrc\external\libs\SDL3 src\main\main.cpp src\renderer\Window.cpp -o out\Release\BasicsVulkan.exe -lSDL3
            "args": [
                // flags
                "-O3",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-Wno-unused-result",

                // defines
                "-DPROJECT_NAME=\\\"${workspaceFolderBasename}\\\"",
                "-DPROJECT_VERSION=\\\"1.0.0\\\"",
                // includes
                "-I${workspaceFolder}\\src\\external\\includes",  
                // libraries 
                "-L${workspaceFolder}\\src\\external\\libs\\SDL3",
                "-L${workspaceFolder}\\src\\external\\libs\\Vulkan",
                // sources
                "${workspaceFolder}\\src\\main\\main.cpp", 
                "${workspaceFolder}\\src\\renderer\\Window.cpp",
                "-o", 
                // output
                "${workspaceFolder}\\out\\Release\\${workspaceFolderBasename}.exe",         
                "-lSDL3",
                "-lvulkan-1"
            ],
            
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task to build project release"
        },
        {
    "label": "Build debug",
    "type": "cppbuild",
    "command": "g++",
    "args": [
        "-g",                     // información de debug
        "-O0",                    // sin optimización
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-result",

        // defines
        // defines
        "-DPROJECT_NAME=\\\"${workspaceFolderBasename}\\\"",
        "-DPROJECT_VERSION=\\\"1.0.0\\\"",
        "-D_DEBUG",
        // includes
        "-I${workspaceFolder}\\src\\external\\includes", 
        // libraries 
        "-L${workspaceFolder}\\src\\external\\libs\\SDL3",
        "-L${workspaceFolder}\\src\\external\\libs\\Vulkan",
        // sources
        "${workspaceFolder}\\src\\main\\main.cpp", 
        "${workspaceFolder}\\src\\renderer\\Window.cpp",
        "-o", 
        // output
        "${workspaceFolder}\\out\\Debug\\${workspaceFolderBasename}.exe",         
        "-lSDL3d",
        "-lvulkan-1"
    ],
    "options": {
        "cwd": "${fileDirname}"
    },
    "problemMatcher": [
        "$gcc"
    ],
    "group": {
        "kind": "build",
        "isDefault": true
    }
}
    ]
}
